# Copy to .env for local runs. In Azure these are set as Container App environment variables and secrets by infra/deploy.sh.
DATABASE_URL=postgres://astra:astra@localhost:5433/astra
PORT=8080
# Frozen demo clock so rehearsals and the orals show the same values
DEMO_TODAY=2026-10-13
DEMO_MODE=true
# Load the seed automatically when the database is empty
SEED_ON_BOOT=true
# Optional: Azure OpenAI (prompts only; narrative polish with citation check and parser fallback). Leave empty to run fully deterministic.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: Azure AI Speech (in-tenant speech). Leave empty to use the browser's speech engine.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
